# Copy to .env for local development (portable PostgreSQL).
# On Render these are set via render.yaml / dashboard (DATABASE_URL is auto).
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Local Postgres (portable instance on port 5433)
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=postgres
PGPASSWORD=virava
PGDATABASE=virava

# Production uses a single connection string instead of the PG* vars above:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES=7d

ADMIN_NAME=Virava Admin
ADMIN_EMAIL=admin@viravachemicals.com
ADMIN_PASSWORD=Virava@2026
