# dependencies
node_modules/
**/node_modules/

# build output
client/dist/
dist/

# env / secrets
.env
server/.env
*.local

# local portable PostgreSQL (Render provides its own DB) — very large
database/

# local tunnel binary
cloudflared.exe
pg.zip

# uploads (runtime, user-generated)
server/uploads/*
!server/uploads/.gitkeep

# client source documents — the product sheet carries per-kg rates, which should
# not reach a hosted repo. Kept locally; the catalogue lives in godrej-catalogue.js
*.xlsx
*.xls
*.docx
~$*

# misc
*.log
home.html
.DS_Store
Thumbs.db
